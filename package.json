{
  "name": "release-me",
  "version": "0.0.1",
  "private": false,
  "description": "GitHub Release Management",
  "author": "Kevin de Jong",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/dev-build-deploy/release-me",
  "keywords": [
    "github",
    "action",
    "releases"
  ],
  "bugs": {
    "url": "https://github.com/dev-build-deploy/release-me/issues"
  },
  "scripts": {
    "build": "run-p build:* && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs lib",
    "build:assets": "ncc build -o lib/assets src/entrypoints/assets.ts",
    "build:get": "ncc build -o lib/get src/entrypoints/get.ts",
    "build:main": "ncc build -o lib/main src/entrypoints/main.ts",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write **/*.ts",
    "prepare": "node -e \"if(process.env.CI)process.exit(0);const r=require('child_process').spawnSync('pre-commit',['install','--hook-type','pre-commit','--hook-type','commit-msg'],{stdio:'inherit'});if(r.error)console.log('hint: install pre-commit (https://pre-commit.com) to get the git hooks')\""
  },
  "dependencies": {
    "@actions/artifact": "^2",
    "@actions/core": "^1",
    "@actions/github": "^6",
    "@dev-build-deploy/commit-it": "^2",
    "@dev-build-deploy/version-it": "^1",
    "minimatch": "^10.2.5",
    "yaml": "^2"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9",
    "@octokit/openapi-types": "^23",
    "@types/jest": "^29",
    "@types/node": "^24.13.1",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vercel/ncc": "^0",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-import": "^2",
    "eslint-plugin-jest": "^28",
    "globals": "^16",
    "jest": "^29",
    "npm-run-all2": "^8",
    "prettier": "^3",
    "ts-jest": "^29",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
