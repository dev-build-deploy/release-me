{
  "name": "release-me",
  "version": "0.0.1",
  "private": false,
  "description": "GitHub Release Management",
  "author": "Kevin de Jong",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/dev-build-deploy/release-me",
  "keywords": [
    "github",
    "action",
    "releases"
  ],
  "bugs": {
    "url": "https://github.com/dev-build-deploy/release-me/issues"
  },
  "scripts": {
    "build": "run-p build:*",
    "build:assets": "ncc build -o lib/assets src/entrypoints/assets.ts",
    "build:get": "ncc build -o lib/get src/entrypoints/get.ts",
    "build:main": "ncc build -o lib/main src/entrypoints/main.ts",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write **/*.ts"
  },
  "dependencies": {
    "@actions/artifact": "^2",
    "@actions/core": "^1",
    "@actions/github": "^6",
    "@dev-build-deploy/commit-it": "^2",
    "@dev-build-deploy/version-it": "^1",
    "yaml": "^2"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9",
    "@octokit/openapi-types": "^23",
    "@tsconfig/node20": "^20",
    "@types/jest": "^29",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-import": "^2",
    "eslint-plugin-jest": "^28",
    "@vercel/ncc": "^0",
    "globals": "^16",
    "jest": "^29",
    "npm-run-all2": "^7",
    "prettier": "^3",
    "ts-jest": "^29",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
